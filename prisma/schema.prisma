generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model company {
  company_idx BigInt    @id @default(autoincrement())
  is_deleted  Boolean   @default(false)
  created_dt  DateTime? @default(now()) @db.DateTime(0)
  updated_dt  DateTime? @default(now()) @db.DateTime(0)
}

model knex_migrations {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  name           String?   @db.VarChar(255)
  batch          Int?
  migration_time DateTime? @db.Timestamp(0)
}

model knex_migrations_lock {
  index     Int  @id @default(autoincrement()) @db.UnsignedInt
  is_locked Int?
}

model product {
  product_idx     BigInt            @id @default(autoincrement())
  company_idx     BigInt
  name            String            @db.VarChar(255)
  price           BigInt            @db.UnsignedBigInt
  stock           BigInt            @db.UnsignedBigInt
  is_deleted      Boolean           @default(false)
  created_dt      DateTime?         @default(now()) @db.DateTime(0)
  updated_dt      DateTime?         @default(now()) @db.DateTime(0)
  product_image   product_image[]
  shopping_basket shopping_basket[]

  @@index([company_idx], map: "company_idx")
}

model shopping_basket {
  user_idx    BigInt
  product_idx BigInt
  quantity    Int       @db.UnsignedInt
  created_dt  DateTime? @default(now()) @db.DateTime(0)
  updated_dt  DateTime? @default(now()) @db.DateTime(0)
  product     product   @relation(fields: [product_idx], references: [product_idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_shopping_basket_product")
  users       users     @relation(fields: [user_idx], references: [user_idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_shopping_basket_user")

  @@id([user_idx, product_idx])
  @@index([product_idx], map: "fk_shopping_basket_product")
}

model users {
  user_idx        BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(50)
  phone_number    String            @db.VarChar(50)
  gender          Boolean
  is_deleted      Boolean           @default(false)
  created_dt      DateTime?         @default(now()) @db.DateTime(0)
  updated_dt      DateTime?         @default(now()) @db.DateTime(0)
  auth            auth[]
  shopping_basket shopping_basket[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users_address {
  address_idx    BigInt    @id @default(autoincrement())
  user_idx       BigInt
  zonecode       String    @db.VarChar(10)
  road_address   String    @db.VarChar(255)
  detail_address String?   @db.VarChar(255)
  jibun_address  String?   @db.VarChar(255)
  receiver_name  String?   @db.VarChar(50)
  receiver_phone String?   @db.VarChar(50)
  is_default     Boolean   @default(false)
  is_deleted     Boolean   @default(false)
  created_dt     DateTime? @default(now()) @db.DateTime(0)
  updated_dt     DateTime? @default(now()) @db.DateTime(0)

  @@index([user_idx], map: "user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model order_product {
  order_product_idx BigInt    @id @default(autoincrement())
  order_idx         BigInt
  product_idx       BigInt
  quantity          Int       @db.UnsignedInt
  unit_price        BigInt    @db.UnsignedBigInt
  created_dt        DateTime? @default(now()) @db.DateTime(0)
  updated_dt        DateTime? @default(now()) @db.DateTime(0)

  @@index([order_idx], map: "order_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model orders {
  order_idx      BigInt    @id @default(autoincrement())
  user_idx       BigInt
  total_amount   BigInt    @db.UnsignedBigInt
  zonecode       String    @db.VarChar(10)
  road_address   String    @db.VarChar(255)
  detail_address String?   @db.VarChar(255)
  jibun_address  String?   @db.VarChar(255)
  receiver_name  String?   @db.VarChar(50)
  receiver_phone String?   @db.VarChar(50)
  status         String    @default("PENDING") @db.VarChar(20)
  created_dt     DateTime? @default(now()) @db.DateTime(0)
  updated_dt     DateTime? @default(now()) @db.DateTime(0)

  @@index([user_idx], map: "user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model auth {
  auth_idx      BigInt    @id @default(autoincrement())
  user_idx      BigInt
  provider      String    @db.VarChar(20)
  provider_key  String    @db.VarChar(255)
  account_name  String?   @db.VarChar(255)
  password_hash String?   @db.VarChar(255)
  is_deleted    Boolean   @default(false)
  created_dt    DateTime? @default(now()) @db.DateTime(0)
  updated_dt    DateTime? @default(now()) @db.DateTime(0)
  users         users     @relation(fields: [user_idx], references: [user_idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_auth_user")

  @@unique([provider, provider_key], map: "uk_auth_provider_key")
  @@index([user_idx], map: "user_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model product_image {
  product_image_idx BigInt    @id @default(autoincrement())
  product_idx       BigInt
  image_url         String    @db.VarChar(255)
  is_primary        Boolean   @default(false)
  is_deleted        Boolean   @default(false)
  created_dt        DateTime? @default(now()) @db.DateTime(0)
  updated_dt        DateTime? @default(now()) @db.DateTime(0)
  product           product   @relation(fields: [product_idx], references: [product_idx], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_image_product")

  @@index([product_idx], map: "product_idx")
}
